{
  "entity": {
    "sensor": {
      "profile": {
        "default": "mdi:calendar-clock",
        "state": {
          "summer": "mdi:weather-sunny",
          "winter": "mdi:snowflake",
          "offpeak": "mdi:calendar-weekend"
        }
      },
      "pending": {
        "default": "mdi:file-compare"
      },
      "status": {
        "default": "mdi:information-outline",
        "state": {
          "off": "mdi:power-off",
          "read_only": "mdi:eye-outline",
          "live": "mdi:pencil-circle"
        }
      },
      "storm": {
        "default": "mdi:weather-partly-cloudy",
        "state": {
          "prep": "mdi:weather-lightning-rainy",
          "watch": "mdi:weather-windy",
          "unknown": "mdi:cloud-off-outline",
          "not_configured": "mdi:cog-outline"
        }
      }
    },
    "switch": {
      "enabled": {
        "default": "mdi:power"
      },
      "dry_run": {
        "default": "mdi:test-tube"
      },
      "write_charge_window": {
        "default": "mdi:clock-edit-outline"
      },
      "write_hold_windows": {
        "default": "mdi:shield-lock-outline"
      },
      "write_soc": {
        "default": "mdi:battery-lock"
      },
      "write_power": {
        "default": "mdi:flash-outline"
      },
      "storm_prep": {
        "default": "mdi:shield-home"
      },
      "storm_auto": {
        "default": "mdi:autorenew"
      }
    },
    "number": {
      "end_soc_summer": {
        "default": "mdi:battery-charging-80"
      },
      "end_soc_winter": {
        "default": "mdi:battery-charging-70"
      },
      "end_soc_offpeak": {
        "default": "mdi:battery-charging-50"
      },
      "ac_charge_kw": {
        "default": "mdi:transmission-tower-import"
      },
      "storm_target_soc": {
        "default": "mdi:battery-arrow-up"
      }
    },
    "time": {
      "charge_start": {
        "default": "mdi:clock-start"
      },
      "charge_end": {
        "default": "mdi:clock-end"
      }
    },
    "select": {
      "tariff": {
        "default": "mdi:cash-clock"
      }
    },
    "button": {
      "storm_skip": {
        "default": "mdi:debug-step-over"
      }
    }
  },
  "services": {
    "update_settings": {
      "service": "mdi:calendar-edit"
    },
    "set_tariff": {
      "service": "mdi:swap-horizontal"
    },
    "save_tariff_as": {
      "service": "mdi:content-save-plus"
    },
    "delete_tariff": {
      "service": "mdi:delete"
    },
    "get_plan": {
      "service": "mdi:clipboard-text-clock-outline"
    },
    "import_tariff": {
      "service": "mdi:file-import-outline"
    }
  }
}
